{
  "name": "aerodrome",
  "version": "2.0.0",
  "description": "Base layer AMM on EVMs",
  "directories": {
    "lib": "lib"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "4.8.0",
    "decimal.js": "^10.4.3",
    "prettier": "^2.6.2",
    "prettier-plugin-solidity": "^1.0.0-beta.19",
    "solhint": "^3.3.7",
    "solhint-plugin-prettier": "^0.0.5"
  },
  "scripts": {
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.sol' 'script/**/*.sol'",
    "format:check": "prettier --check 'contracts/**/*.sol' 'test/**/*.sol' 'script/**/*.sol'",
    "lint": "solhint --fix 'contracts/**/*.sol' 'test/**/*.sol' 'script/**/*.sol'",
    "lint:check": "solhint 'contracts/**/*.sol' 'test/**/*.sol' 'script/**/*.sol'"
  }
}
