# Deployment signer (hex private key)
PRIVATE_KEY_DEPLOY=0x...

# Optional role overrides (defaults to deployer when unset)
FEE_MANAGER=0x0000000000000000000000000000000000000000
PAUSER=0x0000000000000000000000000000000000000000

# Required wrapped HSK address on target network
WHSK=0x0000000000000000000000000000000000000000

# Optional fee overrides (basis points)
STABLE_FEE=5
VOLATILE_FEE=30

# Optional output file name under script/constants/output/
OUTPUT_FILENAME=dex-latest.json

# RPC endpoints (set according to network)
RPC_URL=

# Optional block number when running forked tests/scripts
FORK_BLOCK_NUMBER=
